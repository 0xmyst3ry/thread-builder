# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Twitter API Configuration
# Get your API keys from https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Unsplash API (for image search feature)
# Get your API key from https://unsplash.com/developers
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Application Settings
NODE_ENV=development

# Optional: Enable mock errors in development (for testing error handling)
ENABLE_MOCK_ERRORS=false

# Database Configuration (future use)
# DATABASE_URL=your_database_connection_string_here

# Authentication (future use)
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000
